# =============================================================================
# infra/scripts/.env.example
# Copy this file to infra/scripts/.env and fill in your values.
# .env is gitignored — never commit it.
#
# Fetch APIM_KEY:
#   az apim subscription show \
#     --resource-group ai-obs-sre-demo \
#     --service-name aiosre-apim-demo \
#     --sid voice-orders \
#     --query primaryKey -o tsv
#
# Usage (bash / WSL):
#   source infra/scripts/.env
#   bash infra/scripts/60-fault-toggle.sh cosmos-dns-break on
#   bash infra/scripts/70-seed-demo-data.sh
#
# Usage (PowerShell):
#   Get-Content infra/scripts/.env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]+)=(.+)') { Set-Item "env:$($Matches[1])" $Matches[2] }
#   }
#   .\infra\scripts\70-seed-demo-data.ps1
# =============================================================================

APIM_GW_URL=https://aiosre-apim-demo.azure-api.net
APIM_KEY=<replace-with-your-apim-subscription-key>
RG=ai-obs-sre-demo
APIM=aiosre-apim-demo
COSMOS_ACCOUNT=aiosrecosmosdemo4lrdqw4e2yr2s
