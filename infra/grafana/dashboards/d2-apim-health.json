{
  "uid": "apim-health",
  "title": "D2 — APIM Health (multi-source)",
  "schemaVersion": 39, "version": 1, "refresh": "30s",
  "tags": ["sre-demo","apim"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [
    { "name":"correlation_id", "type":"textbox", "current":{"value":""} }
  ]},
  "panels": [
    {
      "id":1, "type":"timeseries", "title":"APIM 4xx/5xx (Azure Monitor)",
      "datasource": { "type":"grafana-azure-monitor-datasource", "uid":"azure-monitor-oob" },
      "targets": [
        { "queryType": "Azure Monitor", "refId": "A", "azureMonitor": { "metricName":"FailedRequests", "aggregation":"Total", "metricNamespace":"Microsoft.ApiManagement/service", "resourceGroup":"ai-obs-sre-demo", "resourceName":"aiosre-apim-demo", "subscription":"ba43c91f-2d76-4000-a7ad-24750cab54c3", "timeGrain":"auto" }},
        { "queryType": "Azure Monitor", "refId": "B", "azureMonitor": { "metricName":"SuccessfulRequests", "aggregation":"Total", "metricNamespace":"Microsoft.ApiManagement/service", "resourceGroup":"ai-obs-sre-demo", "resourceName":"aiosre-apim-demo", "subscription":"ba43c91f-2d76-4000-a7ad-24750cab54c3", "timeGrain":"auto" }}
      ],
      "gridPos":{"x":0,"y":0,"w":12,"h":7}
    },
    {
      "id":2, "type":"timeseries", "title":"APIM Latency avg (Azure Monitor)",
      "datasource": { "type":"grafana-azure-monitor-datasource", "uid":"azure-monitor-oob" },
      "targets": [{ "queryType": "Azure Monitor", "refId": "A", "azureMonitor": { "metricName":"Duration", "aggregation":"Average", "metricNamespace":"Microsoft.ApiManagement/service", "resourceGroup":"ai-obs-sre-demo", "resourceName":"aiosre-apim-demo", "subscription":"ba43c91f-2d76-4000-a7ad-24750cab54c3", "timeGrain":"auto" }}],
      "gridPos":{"x":12,"y":0,"w":12,"h":7}
    },
    {
      "id":3, "type":"timeseries", "title":"APIM diagnostics: status by operation (ADX)",
      "datasource": { "type":"grafana-azure-data-explorer-datasource", "uid":"{{ADX_DS_UID}}" },
      "targets": [{
        "refId":"A", "rawMode":true, "resultFormat":"time_series",
        "query":"APIMGatewayLogs | summarize c=count() by bin(Timestamp,1m), Status, OperationName | order by Timestamp asc"
      }],
      "gridPos":{"x":0,"y":7,"w":24,"h":8}
    },
    {
      "id":4, "type":"table", "title":"APIM 5xx joined with backend AppExceptions on x-correlation-id",
      "datasource": { "type":"grafana-azure-data-explorer-datasource", "uid":"{{ADX_DS_UID}}" },
      "targets": [{
        "refId":"A", "rawMode":true, "resultFormat":"table",
        "query":"let apim5xx = APIMGatewayLogs | where Status >= 500 | project Timestamp, ApiName, OperationName, Status, BackendStatus, TotalTimeMs, CorrelationId, Traceparent, RequestId; let appErr = AppExceptions | project ExcTs=Timestamp, ExceptionType, ExceptionMessage, DependencyName, CorrelationId, ServiceName, Pod; apim5xx | join kind=leftouter appErr on CorrelationId | top 200 by Timestamp desc"
      }],
      "gridPos":{"x":0,"y":15,"w":24,"h":12}
    }
  ]
}

